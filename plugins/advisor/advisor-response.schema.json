{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recommendation",
    "why",
    "strongest_objection",
    "change_my_mind",
    "acceptance_checks",
    "risks",
    "follow_up_areas",
    "escalation"
  ],
  "properties": {
    "recommendation": {
      "type": "string",
      "pattern": "\\S"
    },
    "why": {
      "type": "string",
      "pattern": "\\S"
    },
    "strongest_objection": {
      "type": "string",
      "pattern": "\\S"
    },
    "change_my_mind": {
      "type": "string",
      "pattern": "\\S"
    },
    "acceptance_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "risks": {
      "type": "string",
      "pattern": "\\S"
    },
    "follow_up_areas": {
      "type": "string",
      "pattern": "\\S"
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "next_level",
        "reason",
        "unresolved_difficulty",
        "required_resolution"
      ],
      "properties": {
        "next_level": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "medium",
            "high",
            "extra_high"
          ]
        },
        "reason": {
          "type": "string"
        },
        "unresolved_difficulty": {
          "type": "string"
        },
        "required_resolution": {
          "type": "string"
        }
      }
    }
  }
}
