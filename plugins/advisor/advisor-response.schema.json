{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recommendation",
    "why",
    "strongest_objection",
    "change_my_mind",
    "acceptance_checks",
    "risks",
    "follow_up_areas",
    "escalation"
  ],
  "properties": {
    "recommendation": { "type": "string" },
    "why": { "type": "string" },
    "strongest_objection": { "type": "string" },
    "change_my_mind": { "type": "string" },
    "acceptance_checks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "risks": { "type": "string" },
    "follow_up_areas": { "type": "string" },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next_level", "reason", "unresolved_difficulty", "required_resolution"],
      "properties": {
        "next_level": { "enum": [null, "medium", "high", "extra_high"] },
        "reason": { "type": "string" },
        "unresolved_difficulty": { "type": "string" },
        "required_resolution": { "type": "string" }
      }
    }
  }
}
