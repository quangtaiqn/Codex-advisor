{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recommendation",
    "why",
    "strongest_objection",
    "change_my_mind",
    "acceptance_checks",
    "risks",
    "follow_up_areas",
    "escalation"
  ],
  "properties": {
    "recommendation": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "why": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "strongest_objection": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "change_my_mind": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "acceptance_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "risks": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "follow_up_areas": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "next_level",
        "reason",
        "unresolved_difficulty",
        "required_resolution"
      ],
      "properties": {
        "next_level": {
          "enum": [
            null,
            "medium",
            "high",
            "extra_high"
          ]
        },
        "reason": {
          "type": "string"
        },
        "unresolved_difficulty": {
          "type": "string"
        },
        "required_resolution": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "next_level": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "minLength": 1,
                "pattern": "\\S"
              },
              "unresolved_difficulty": {
                "minLength": 1,
                "pattern": "\\S"
              },
              "required_resolution": {
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    }
  }
}
